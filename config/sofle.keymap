#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define BASE 0
#define LOWER 1
#define RAISE 2
#define ADJUST 3

/ {
    // Activate ADJUST layer by pressing raise and lower

    conditional_layers {
        compatible = "zmk,conditional-layers";

        adjust_layer {
            if-layers = <6 7>;
            then-layer = <8>;
        };
    };

    macros {
        AdvncedPaste: AdvncedPaste {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp LS(LG(V))>,
                <&macro_wait_time 800>,
                <&kp LEFT_GUI>,
                <&macro_wait_time 800>,
                <&kp LEFT_GUI>,
                <&macro_wait_time 800>,
                <&kp LEFT_SHIFT>;

            label = "ADVNCEDPASTE";
        };

        F_623_MK: F_623_MK {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp D &kp S &kp D &kp K>;
            label = "F_623_MK";
        };

        F_421_MK: F_421_MK {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp A &kp S &kp A &kp K>;
